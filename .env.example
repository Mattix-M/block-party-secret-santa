# Hosted deployment: generate three DIFFERENT, private values (32 random bytes each),
# set them as server-only Vercel environment variables, then deploy.
# Invite the group with /join/<GROUP_INVITE>. Only the organizer uses /join/<HOST_INVITE>.
GROUP_INVITE=
HOST_INVITE=
# Keep this key for the lifetime of the exchange. It also protects the encrypted game.
SESSION_SECRET=

# Connect a private Vercel Blob store to the project. Its managed credentials
# are injected by Vercel. Use the attached store ID/OIDC or its read-write token.
# BLOB_STORE_ID=
# BLOB_READ_WRITE_TOKEN=

# Local npm run dev grants guest access on localhost; /join/host-local is the local host.
# For localhost npm run start with the same behavior, set PARTY_LOCAL=1.
# Local data and a generated development signing key live under .local/.

# Server-only, unpadded base64url key made from 32 random bytes. Preserve it across builds.
# A clean production checkout retrieves its encrypted roster from the attached private
# Blob store. For the first trusted Vercel build only, supply private/roster.enc through
# a private source upload and use: node scripts/roster.mjs store && npm run build
# Later builds use npm run build. Keep the local bundle outside the public repository.
ROSTER_KEY=
