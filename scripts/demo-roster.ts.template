// Block Party public demo roster. Generated by scripts/roster.mjs.
export type Player = {
  id: string;
  name: string;
  first: string;
  handle: string;
  bio: string;
  posts: number;
  followers: number;
  following: number;
  photo: string;
  x: number;
  y: number;
  size: number;
  shade: string;
};

const ids: string[] = __ROSTER_IDS__;

export const players: Player[] = ids.map((id, index) => {
  const number = String(index + 1).padStart(2, "0");
  return {
    id,
    name: "Player " + number,
    first: "Player " + number,
    handle: "player" + number,
    bio: "In for the gift exchange.",
    posts: 0,
    followers: 0,
    following: 0,
    photo: "/demo-avatar.svg",
    x: 0,
    y: 0,
    size: 1206,
    shade: index % 2 === 0 ? "#20523f" : "#9e2837",
  };
});

export const getPlayer = (id: string | null) => players.find(person => person.id === id);
